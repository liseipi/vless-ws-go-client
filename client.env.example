# 客户端连接配置。
# 首次使用：
#   cp client.env.example client.env
#   然后编辑 client.env，填入你自己的值
#
# client.env 不会被 run-client.sh 覆盖，改这个文件就行，不用碰 run-client.sh。

SERVER_HOST="your-domain.com"
SERVER_PORT="443"
WS_PATH="/api"
UUID="a3d2e1f0-b4c5-4d6e-8f70-1a2b3c4d5e6f"
TOKEN="你的TOKEN"

LOCAL_IP="127.0.0.1"
LOCAL_PORT="1080"

# 下面这些是可选项，跟 config.go 里的默认值一致，一般不需要改：
# USE_TLS="true"
# INSECURE="false"
# LOG_LEVEL="info"
